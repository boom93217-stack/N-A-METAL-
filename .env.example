# TiDB connection string (mysql:// or mysql2-compatible), same one used before migration.
DATABASE_URL=

# Secret used to sign admin session JWTs. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Single admin account for /manage/projects. Keep these only in Vercel's encrypted
# env vars / your local .env — never commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Vercel Blob store token. In Vercel, connect a Blob store to the project and this
# is injected automatically; for local dev, copy it from the Vercel dashboard
# (Storage -> your Blob store -> .env.local tab) or run `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
